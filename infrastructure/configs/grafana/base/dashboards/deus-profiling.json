    {
      "type": "flamegraph",
      "title": "CPU flame graph — $service $version",
      "description": "Every stack the profiler sampled in the selected time range, merged. Width is CPU time: the widest frames at the top are the hot functions, the frames below them are their callers. The table ranks functions by self time (spent in the function itself) and total time (including what it calls); click a row or a frame to focus on it. Anonymous functions are named by package or file and line. Only JavaScript on the main thread is sampled: waiting for the database or another service does not appear here (use the slow traces), native work such as TLS or compression does not either.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "Pyroscope"
      },
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "Pyroscope"
          },
          "refId": "A",
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_namespace=\"deus\", service_name=\"$service\", service_version=\"$version\", k8s_pod_name=~\"${pod:regex}\"}",
          "groupBy": []
        }
      ],
      "id": 8,
