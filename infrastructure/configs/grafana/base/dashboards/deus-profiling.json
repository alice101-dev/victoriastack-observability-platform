          "refId": "A",
          "queryType": "metrics",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_namespace=\"deus\", service_name=\"$service\", service_version=\"$version\"}",
          "groupBy": [
            "k8s_pod_name"
          ],
          "legendFormat": "{{k8s_pod_name}}"
        }
      ],
      "id": 6,
      "gridPos": {
