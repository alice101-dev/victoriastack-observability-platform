{
  "uid": "deus-profiling",
  "title": "Deus — Profiling",
  "description": "Where the deus services spend CPU, from the continuous profiles in Pyroscope: CPU per service, the symptoms of one service (latency, errors, CPU per pod) to pick the time range, its flame graph, two versions side by side, and the code all services share.",
  "tags": [
    "deus",
    "profiling",
    "custom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-pyroscope-datasource",
          "uid": "Pyroscope"
        },
        "query": {
          "type": "labelValue",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelName": "service_name",
          "refId": "service"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "ledger",
          "value": "ledger"
        }
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "hide": 0,
        "query": {
          "query": "query_result(sort_desc(min by (service_version) (min_over_time(timestamp(process_runtime_heap_used_bytes{service_namespace=\"deus\", service_name=\"$service\"})[$__range]))))",
          "refId": "version"
        },
        "definition": "query_result(sort_desc(min by (service_version) (min_over_time(timestamp(process_runtime_heap_used_bytes{service_namespace=\"deus\", service_name=\"$service\"})[$__range]))))",
        "regex": "/service_version=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "compare",
        "label": "Compare with",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "hide": 0,
        "query": {
          "query": "query_result(sort(min by (service_version) (min_over_time(timestamp(process_runtime_heap_used_bytes{service_namespace=\"deus\", service_name=\"$service\"})[$__range]))))",
          "refId": "compare"
        },
        "definition": "query_result(sort(min by (service_version) (min_over_time(timestamp(process_runtime_heap_used_bytes{service_namespace=\"deus\", service_name=\"$service\"})[$__range]))))",
        "regex": "/service_version=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": {
          "query": "label_values(process_runtime_heap_used_bytes{service_namespace=\"deus\", service_name=\"$service\", service_version=\"$version\"}, k8s_pod_name)",
          "refId": "pod"
        },
        "definition": "label_values(process_runtime_heap_used_bytes{service_namespace=\"deus\", service_name=\"$service\", service_version=\"$version\"}, k8s_pod_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Deus dashboards",
      "type": "dashboards",
      "tags": [
